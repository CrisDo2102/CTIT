{
  "name": "embedded-roadmap-starter",
  "version": "0.9.2-tsinghua-link-library-clean",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm test && npm run check:secrets && npm run build",
    "check:secrets": "node scripts/secret-scan.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "dev:fixtures": "node scripts/dev-fixtures.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "e2e:all": "npm run build && npm run build:fixtures && npm run test:e2e"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.4"
  }
}
